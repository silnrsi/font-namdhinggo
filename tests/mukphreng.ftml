  <testgroup label="B: Consonants + glide + right vowel + Mukphreng">
    <test label="1900">
      <comment>vowelcarrier-limb</comment>
      <string>\u001900\u001929\u001923\u001939\u00191E \u001900\u001929\u001923\u001939\u000965 \u001900\u001929\u001923\u001939. \u001900\u001929\u001923\u001939\u00F131 \u001900\u001929\u001924\u001939\u00191E \u001900\u001929\u001924\u001939\u000965 \u001900\u001929\u001924\u001939. \u001900\u001929\u001924\u001939\u00F131 \u001900\u001929\u001925\u001939\u00191E \u001900\u001929\u001925\u001939\u000965 \u001900\u001929\u001925\u001939. \u001900\u001929\u001925\u001939\u00F131 \u001900\u001929\u001926\u001939\u00191E \u001900\u001929\u001926\u001939\u000965 \u001900\u001929\u001926\u001939. \u001900\u001929\u001926\u001939\u00F131 \u001900\u00192A\u001923\u001939\u00191E \u001900\u00192A\u001923\u001939\u000965 \u001900\u00192A\u001923\u001939. \u001900\u00192A\u001923\u001939\u00F131 \u001900\u00192A\u001924\u001939\u00191E \u001900\u00192A\u001924\u001939\u000965 \u001900\u00192A\u001924\u001939. \u001900\u00192A\u001924\u001939\u00F131 \u001900\u00192A\u001925\u001939\u00191E \u001900\u00192A\u001925\u001939\u000965 \u001900\u00192A\u001925\u001939. \u001900\u00192A\u001925\u001939\u00F131 \u001900\u00192A\u001926\u001939\u00191E \u001900\u00192A\u001926\u001939\u000965 \u001900\u00192A\u001926\u001939. \u001900\u00192A\u001926\u001939\u00F131 \u001900\u00192B\u001923\u001939\u00191E \u001900\u00192B\u001923\u001939\u000965 \u001900\u00192B\u001923\u001939. \u001900\u00192B\u001923\u001939\u00F131 \u001900\u00192B\u001924\u001939\u00191E \u001900\u00192B\u001924\u001939\u000965 \u001900\u00192B\u001924\u001939. \u001900\u00192B\u001924\u001939\u00F131 \u001900\u00192B\u001925\u001939\u00191E \u001900\u00192B\u001925\u001939\u000965 \u001900\u00192B\u001925\u001939. \u001900\u00192B\u001925\u001939\u00F131 \u001900\u00192B\u001926\u001939\u00191E \u001900\u00192B\u001926\u001939\u000965 \u001900\u00192B\u001926\u001939. \u001900\u00192B\u001926\u001939\u00F131</string>
    </test>
    <test label="1901">
