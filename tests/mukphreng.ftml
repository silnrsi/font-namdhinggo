  <testgroup label="A: Consonants + vowel + Mukphreng + soft hyphen">
    <test label="1900">
      <comment>vowelcarrier-limb</comment>
      <string>\u001900\u001920\u001939\u0000AD\u00191E \u001900\u001920\u001939\u0000AD\u000965 \u001900\u001920\u001939\u0000AD. \u001900\u001920\u001939\u0000AD\u00F131 \u001900\u001921\u001939\u0000AD\u00191E \u001900\u001921\u001939\u0000AD\u000965 \u001900\u001921\u001939\u0000AD. \u001900\u001921\u001939\u0000AD\u00F131 \u001900\u001922\u001939\u0000AD\u00191E \u001900\u001922\u001939\u0000AD\u000965 \u001900\u001922\u001939\u0000AD. \u001900\u001922\u001939\u0000AD\u00F131 \u001900\u001923\u001939\u0000AD\u00191E \u001900\u001923\u001939\u0000AD\u000965 \u001900\u001923\u001939\u0000AD. \u001900\u001923\u001939\u0000AD\u00F131 \u001900\u001924\u001939\u0000AD\u00191E \u001900\u001924\u001939\u0000AD\u000965 \u001900\u001924\u001939\u0000AD. \u001900\u001924\u001939\u0000AD\u00F131 \u001900\u001925\u001939\u0000AD\u00191E \u001900\u001925\u001939\u0000AD\u000965 \u001900\u001925\u001939\u0000AD. \u001900\u001925\u001939\u0000AD\u00F131 \u001900\u001926\u001939\u0000AD\u00191E \u001900\u001926\u001939\u0000AD\u000965 \u001900\u001926\u001939\u0000AD. \u001900\u001926\u001939\u0000AD\u00F131 \u001900\u001927\u001939\u0000AD\u00191E \u001900\u001927\u001939\u0000AD\u000965 \u001900\u001927\u001939\u0000AD. \u001900\u001927\u001939\u0000AD\u00F131 \u001900\u001928\u001939\u0000AD\u00191E \u001900\u001928\u001939\u0000AD\u000965 \u001900\u001928\u001939\u0000AD. \u001900\u001928\u001939\u0000AD\u00F131</string>
    </test>
