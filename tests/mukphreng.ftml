    <test label="1917">
      <comment>la-limb</comment>
      <string>\u001917\u001929\u001920\u001939 \u001917\u00192A\u001920\u001939 \u001917\u00192B\u001920\u001939 \u001917\u001929\u001921\u001939 \u001917\u00192A\u001921\u001939 \u001917\u00192B\u001921\u001939 \u001917\u001929\u001922\u001939 \u001917\u00192A\u001922\u001939 \u001917\u00192B\u001922\u001939 \u001917\u001929\u001923\u001939 \u001917\u00192A\u001923\u001939 \u001917\u00192B\u001923\u001939 \u001917\u001929\u001924\u001939 \u001917\u00192A\u001924\u001939 \u001917\u00192B\u001924\u001939 \u001917\u001929\u001925\u001939 \u001917\u00192A\u001925\u001939 \u001917\u00192B\u001925\u001939 \u001917\u001929\u001926\u001939 \u001917\u00192A\u001926\u001939 \u001917\u00192B\u001926\u001939 \u001917\u001929\u001927\u001939 \u001917\u00192A\u001927\u001939 \u001917\u00192B\u001927\u001939 \u001917\u001929\u001928\u001939 \u001917\u00192A\u001928\u001939 \u001917\u00192B\u001928\u001939</string>
    </test>
    <test label="1918">
      <comment>wa-limb</comment>
      <string>\u001918\u001929\u001920\u001939 \u001918\u00192A\u001920\u001939 \u001918\u00192B\u001920\u001939 \u001918\u001929\u001921\u001939 \u001918\u00192A\u001921\u001939 \u001918\u00192B\u001921\u001939 \u001918\u001929\u001922\u001939 \u001918\u00192A\u001922\u001939 \u001918\u00192B\u001922\u001939 \u001918\u001929\u001923\u001939 \u001918\u00192A\u001923\u001939 \u001918\u00192B\u001923\u001939 \u001918\u001929\u001924\u001939 \u001918\u00192A\u001924\u001939 \u001918\u00192B\u001924\u001939 \u001918\u001929\u001925\u001939 \u001918\u00192A\u001925\u001939 \u001918\u00192B\u001925\u001939 \u001918\u001929\u001926\u001939 \u001918\u00192A\u001926\u001939 \u001918\u00192B\u001926\u001939 \u001918\u001929\u001927\u001939 \u001918\u00192A\u001927\u001939 \u001918\u00192B\u001927\u001939 \u001918\u001929\u001928\u001939 \u001918\u00192A\u001928\u001939 \u001918\u00192B\u001928\u001939</string>
    </test>
    <test label="1919">
      <comment>sha-limb</comment>
      <string>\u001919\u001929\u001920\u001939 \u001919\u00192A\u001920\u001939 \u001919\u00192B\u001920\u001939 \u001919\u001929\u001921\u001939 \u001919\u00192A\u001921\u001939 \u001919\u00192B\u001921\u001939 \u001919\u001929\u001922\u001939 \u001919\u00192A\u001922\u001939 \u001919\u00192B\u001922\u001939 \u001919\u001929\u001923\u001939 \u001919\u00192A\u001923\u001939 \u001919\u00192B\u001923\u001939 \u001919\u001929\u001924\u001939 \u001919\u00192A\u001924\u001939 \u001919\u00192B\u001924\u001939 \u001919\u001929\u001925\u001939 \u001919\u00192A\u001925\u001939 \u001919\u00192B\u001925\u001939 \u001919\u001929\u001926\u001939 \u001919\u00192A\u001926\u001939 \u001919\u00192B\u001926\u001939 \u001919\u001929\u001927\u001939 \u001919\u00192A\u001927\u001939 \u001919\u00192B\u001927\u001939 \u001919\u001929\u001928\u001939 \u001919\u00192A\u001928\u001939 \u001919\u00192B\u001928\u001939</string>
    </test>
    <test label="191A">
      <comment>ssa-limb</comment>
      <string>\u00191A\u001929\u001920\u001939 \u00191A\u00192A\u001920\u001939 \u00191A\u00192B\u001920\u001939 \u00191A\u001929\u001921\u001939 \u00191A\u00192A\u001921\u001939 \u00191A\u00192B\u001921\u001939 \u00191A\u001929\u001922\u001939 \u00191A\u00192A\u001922\u001939 \u00191A\u00192B\u001922\u001939 \u00191A\u001929\u001923\u001939 \u00191A\u00192A\u001923\u001939 \u00191A\u00192B\u001923\u001939 \u00191A\u001929\u001924\u001939 \u00191A\u00192A\u001924\u001939 \u00191A\u00192B\u001924\u001939 \u00191A\u001929\u001925\u001939 \u00191A\u00192A\u001925\u001939 \u00191A\u00192B\u001925\u001939 \u00191A\u001929\u001926\u001939 \u00191A\u00192A\u001926\u001939 \u00191A\u00192B\u001926\u001939 \u00191A\u001929\u001927\u001939 \u00191A\u00192A\u001927\u001939 \u00191A\u00192B\u001927\u001939 \u00191A\u001929\u001928\u001939 \u00191A\u00192A\u001928\u001939 \u00191A\u00192B\u001928\u001939</string>
    </test>
    <test label="191B">
      <comment>sa-limb</comment>
      <string>\u00191B\u001929\u001920\u001939 \u00191B\u00192A\u001920\u001939 \u00191B\u00192B\u001920\u001939 \u00191B\u001929\u001921\u001939 \u00191B\u00192A\u001921\u001939 \u00191B\u00192B\u001921\u001939 \u00191B\u001929\u001922\u001939 \u00191B\u00192A\u001922\u001939 \u00191B\u00192B\u001922\u001939 \u00191B\u001929\u001923\u001939 \u00191B\u00192A\u001923\u001939 \u00191B\u00192B\u001923\u001939 \u00191B\u001929\u001924\u001939 \u00191B\u00192A\u001924\u001939 \u00191B\u00192B\u001924\u001939 \u00191B\u001929\u001925\u001939 \u00191B\u00192A\u001925\u001939 \u00191B\u00192B\u001925\u001939 \u00191B\u001929\u001926\u001939 \u00191B\u00192A\u001926\u001939 \u00191B\u00192B\u001926\u001939 \u00191B\u001929\u001927\u001939 \u00191B\u00192A\u001927\u001939 \u00191B\u00192B\u001927\u001939 \u00191B\u001929\u001928\u001939 \u00191B\u00192A\u001928\u001939 \u00191B\u00192B\u001928\u001939</string>
