  <testgroup label="A: Consonants + glide + Mukphreng + soft hyphen">
    <test label="1900">
      <comment>vowelcarrier-limb</comment>
      <string>\u001900\u001929\u001939\u0000AD\u00191E \u001900\u001929\u001939\u0000AD\u000965 \u001900\u001929\u001939\u0000AD. \u001900\u001929\u001939\u0000AD\u00F131 \u001900\u00192A\u001939\u0000AD\u00191E \u001900\u00192A\u001939\u0000AD\u000965 \u001900\u00192A\u001939\u0000AD. \u001900\u00192A\u001939\u0000AD\u00F131 \u001900\u00192B\u001939\u0000AD\u00191E \u001900\u00192B\u001939\u0000AD\u000965 \u001900\u00192B\u001939\u0000AD. \u001900\u00192B\u001939\u0000AD\u00F131</string>
