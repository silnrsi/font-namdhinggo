  <testgroup label="C: Consonants + vowel + Mukphreng">
    <test label="1900">
      <comment>vowelcarrier-limb</comment>
      <string>\u001900\u001920\u001939\u00191E \u001900\u001920\u001939\u000965 \u001900\u001920\u001939. \u001900\u001920\u001939\u00F131 \u001900\u001921\u001939\u00191E \u001900\u001921\u001939\u000965 \u001900\u001921\u001939. \u001900\u001921\u001939\u00F131 \u001900\u001922\u001939\u00191E \u001900\u001922\u001939\u000965 \u001900\u001922\u001939. \u001900\u001922\u001939\u00F131 \u001900\u001923\u001939\u00191E \u001900\u001923\u001939\u000965 \u001900\u001923\u001939. \u001900\u001923\u001939\u00F131 \u001900\u001924\u001939\u00191E \u001900\u001924\u001939\u000965 \u001900\u001924\u001939. \u001900\u001924\u001939\u00F131 \u001900\u001925\u001939\u00191E \u001900\u001925\u001939\u000965 \u001900\u001925\u001939. \u001900\u001925\u001939\u00F131 \u001900\u001926\u001939\u00191E \u001900\u001926\u001939\u000965 \u001900\u001926\u001939. \u001900\u001926\u001939\u00F131 \u001900\u001927\u001939\u00191E \u001900\u001927\u001939\u000965 \u001900\u001927\u001939. \u001900\u001927\u001939\u00F131 \u001900\u001928\u001939\u00191E \u001900\u001928\u001939\u000965 \u001900\u001928\u001939. \u001900\u001928\u001939\u00F131</string>
    </test>
    <test label="1901">
      <comment>ka-limb</comment>
      <string>\u001901\u001920\u001939\u00191E \u001901\u001920\u001939\u000965 \u001901\u001920\u001939. \u001901\u001920\u001939\u00F131 \u001901\u001921\u001939\u00191E \u001901\u001921\u001939\u000965 \u001901\u001921\u001939. \u001901\u001921\u001939\u00F131 \u001901\u001922\u001939\u00191E \u001901\u001922\u001939\u000965 \u001901\u001922\u001939. \u001901\u001922\u001939\u00F131 \u001901\u001923\u001939\u00191E \u001901\u001923\u001939\u000965 \u001901\u001923\u001939. \u001901\u001923\u001939\u00F131 \u001901\u001924\u001939\u00191E \u001901\u001924\u001939\u000965 \u001901\u001924\u001939. \u001901\u001924\u001939\u00F131 \u001901\u001925\u001939\u00191E \u001901\u001925\u001939\u000965 \u001901\u001925\u001939. \u001901\u001925\u001939\u00F131 \u001901\u001926\u001939\u00191E \u001901\u001926\u001939\u000965 \u001901\u001926\u001939. \u001901\u001926\u001939\u00F131 \u001901\u001927\u001939\u00191E \u001901\u001927\u001939\u000965 \u001901\u001927\u001939. \u001901\u001927\u001939\u00F131 \u001901\u001928\u001939\u00191E \u001901\u001928\u001939\u000965 \u001901\u001928\u001939. \u001901\u001928\u001939\u00F131</string>
    </test>
    <test label="1902">
      <comment>kha-limb</comment>
      <string>\u001902\u001920\u001939\u00191E \u001902\u001920\u001939\u000965 \u001902\u001920\u001939. \u001902\u001920\u001939\u00F131 \u001902\u001921\u001939\u00191E \u001902\u001921\u001939\u000965 \u001902\u001921\u001939. \u001902\u001921\u001939\u00F131 \u001902\u001922\u001939\u00191E \u001902\u001922\u001939\u000965 \u001902\u001922\u001939. \u001902\u001922\u001939\u00F131 \u001902\u001923\u001939\u00191E \u001902\u001923\u001939\u000965 \u001902\u001923\u001939. \u001902\u001923\u001939\u00F131 \u001902\u001924\u001939\u00191E \u001902\u001924\u001939\u000965 \u001902\u001924\u001939. \u001902\u001924\u001939\u00F131 \u001902\u001925\u001939\u00191E \u001902\u001925\u001939\u000965 \u001902\u001925\u001939. \u001902\u001925\u001939\u00F131 \u001902\u001926\u001939\u00191E \u001902\u001926\u001939\u000965 \u001902\u001926\u001939. \u001902\u001926\u001939\u00F131 \u001902\u001927\u001939\u00191E \u001902\u001927\u001939\u000965 \u001902\u001927\u001939. \u001902\u001927\u001939\u00F131 \u001902\u001928\u001939\u00191E \u001902\u001928\u001939\u000965 \u001902\u001928\u001939. \u001902\u001928\u001939\u00F131</string>
    </test>
    <test label="1903">
      <comment>ga-limb</comment>
      <string>\u001903\u001920\u001939\u00191E \u001903\u001920\u001939\u000965 \u001903\u001920\u001939. \u001903\u001920\u001939\u00F131 \u001903\u001921\u001939\u00191E \u001903\u001921\u001939\u000965 \u001903\u001921\u001939. \u001903\u001921\u001939\u00F131 \u001903\u001922\u001939\u00191E \u001903\u001922\u001939\u000965 \u001903\u001922\u001939. \u001903\u001922\u001939\u00F131 \u001903\u001923\u001939\u00191E \u001903\u001923\u001939\u000965 \u001903\u001923\u001939. \u001903\u001923\u001939\u00F131 \u001903\u001924\u001939\u00191E \u001903\u001924\u001939\u000965 \u001903\u001924\u001939. \u001903\u001924\u001939\u00F131 \u001903\u001925\u001939\u00191E \u001903\u001925\u001939\u000965 \u001903\u001925\u001939. \u001903\u001925\u001939\u00F131 \u001903\u001926\u001939\u00191E \u001903\u001926\u001939\u000965 \u001903\u001926\u001939. \u001903\u001926\u001939\u00F131 \u001903\u001927\u001939\u00191E \u001903\u001927\u001939\u000965 \u001903\u001927\u001939. \u001903\u001927\u001939\u00F131 \u001903\u001928\u001939\u00191E \u001903\u001928\u001939\u000965 \u001903\u001928\u001939. \u001903\u001928\u001939\u00F131</string>
